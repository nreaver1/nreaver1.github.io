      },
      {
        "id": "_rr96nq0zb",
        "session_id": "_ani8i45r7",
        "text": "Thane identified his own signature on one of the fraudulent exemptions — he was framed three years ago",
        "members": [],
        "sort_order": 1,
        "created_at": "2026-05-29T17:11:27.000812+00:00"
      },
      {
        "id": "_bm4gdxod8",
        "session_id": "_ani8i45r7",
        "text": "Varek's arrest warrant for Theron is nailed to the door of the Sunken Hearth by morning",
        "members": [
          "Theron"
        ],
        "sort_order": 2,
        "created_at": "2026-05-29T17:11:27.000812+00:00"
      },
      {
        "id": "_cb57awdyu",
        "session_id": "_ani8i45r7",
        "text": "Drav raised his price — \"warrants are bad for business and you're becoming a liability\"",
