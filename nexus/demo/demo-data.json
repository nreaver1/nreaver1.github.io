      },
      {
        "id": "_i6gi3d7zl",
        "number": 1,
        "title": "Rats in the Warehouse",
        "real_date": "2026-05-01",
        "world_date": "3rd of Ashfall, Year 412",
        "summary": "The party arrived in Ashenveil following a tip about a shipment of stolen artefacts passing through the docks. They tracked the delivery to a warehouse in the Dockside Quarter, where they found crates stamped with the Merchant's Compact seal. ^drav-the-fence gave them the initial lead in exchange for clearing a debt with a local tanner. The warehouse was guarded by men working for ^commander-varek-stoneholm — the party slipped past them using a combination of distraction and a well-placed sleep spell. They recovered one artefact (a brass cylinder covered in Primordial script) before the alarm was raised and they were forced to flee across the rooftops.",
        "status": "complete",
        "quests": [
          {
            "_key": "_70xgqf2qs",
            "text": "Identify the brass cylinder recovered from the warehouse",
            "status": "active"
          },
          {
            "_key": "_najqbhvuw",
            "text": "Find out who owns the Compact warehouse on Salter's Row",
            "status": "completed"
          }
        ],
        "session_npcs": [
          "_8qgrzzenw",
          "_zc2j5kobl"
        ],
        "created_at": "2026-05-29T17:11:26.875927+00:00",
        "updated_at": "2026-05-29T17:11:26.875927+00:00"
      },
      {
        "id": "_wob4htma3",
        "number": 3,
        "title": "Fire at the Pale Flame",
        "real_date": "2026-05-15",
        "world_date": "12th of Ashfall, Year 412",
        "summary": "The Temple of the Pale Flame was set alight in the early hours. ^sister-maela sent a runner to warn the party twenty minutes before it happened — she had intercepted a Compact note. The party reached the temple as the fire was spreading. They evacuated three acolytes and a collection of irreplaceable texts before the east wing collapsed. ^the-hollow-man was observed watching the fire from across the street but disappeared before the party could confront him. ^pip appeared uninvited in the middle of the evacuation and nearly got herself killed retrieving a small silver box that Maela had specifically asked her to protect. The box was delivered safely. Maela has not explained its contents.",
        "status": "complete",
        "quests": [
          {
            "_key": "_h0q2f9asl",
            "text": "Find out what is inside the silver box Pip retrieved from the Temple",
            "status": "active"
          },
          {
            "_key": "_gycvcuaa0",
            "text": "Discover who killed the Compact courier and why",
            "status": "active"
