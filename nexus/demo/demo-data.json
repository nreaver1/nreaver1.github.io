    "npcs": [
      {
        "id": "_8qgrzzenw",
        "slug": "commander-varek-stoneholm",
        "name": "Commander Varek Stoneholm",
        "role": "City Watch Commander, Ashenveil Gate",
        "disposition": "hostile",
        "notes": "Broad-shouldered, perpetually scowling. Has been paid off by the Merchant's Compact to look the other way. Deeply suspicious of the party after the warehouse incident. Carries a signet ring that matches one found on a body in Session 2.",
        "first_seen": "_i6gi3d7zl",
        "created_at": "2026-05-29T17:11:26.736552+00:00",
        "updated_at": "2026-05-29T17:11:27.085955+00:00"
      },
      {
        "id": "_zc2j5kobl",
        "slug": "drav-the-fence",
        "name": "Drav the Fence",
        "role": "Black-market broker, Dockside Quarter",
        "disposition": "neutral",
        "notes": "Short, quick-eyed halfling. Operates out of a chandlery as cover. Will sell anything to anyone but refuses to deal in \"cursed goods\" — he lost a brother that way. Owes the party a favour since Session 1. Can be flipped with enough coin.",
        "first_seen": "_i6gi3d7zl",
        "created_at": "2026-05-29T17:11:26.736552+00:00",
        "updated_at": "2026-05-29T17:11:27.085955+00:00"
      },
      {
        "id": "_1p8m5u3r2",
        "slug": "sister-maela",
        "name": "Sister Maela",
        "role": "Healer, Temple of the Pale Flame",
        "disposition": "allied",
        "notes": "Young, earnest, dangerous idealist. She believes the Pale Flame will \"cleanse\" the corruption in Ashenveil — her definition of cleanse worries the party. Has stitched the party back together three times now. Knows more about the Compact than she lets on.",
        "first_seen": "_22jk9q9fj",
        "created_at": "2026-05-29T17:11:26.736552+00:00",
        "updated_at": "2026-05-29T17:11:27.085955+00:00"
      },
      {
        "id": "_1d225p2r9",
        "slug": "pip",
        "name": "Pip",
        "role": "Street informant, urchin network",
        "disposition": "friendly",
        "notes": "Twelve years old, wildly overconfident. Runs a network of child informants across the market district. Will trade information for food, coin, or a good story. Called in a warning that saved the party in Session 3. Should not be in danger but keeps ending up there.",
        "first_seen": "_22jk9q9fj",
        "created_at": "2026-05-29T17:11:26.736552+00:00",
        "updated_at": "2026-05-29T17:11:27.085955+00:00"
      },
      {
        "id": "_zkrz8879r",
        "slug": "the-hollow-man",
        "name": "The Hollow Man",
        "role": "Compact enforcer, identity unknown",
        "disposition": "hostile",
        "notes": "Always masked. Never speaks — communicates via written notes. Has appeared at the scene of every Compact operation the party has disrupted. The party believes he is magically compelled to serve, not a willing agent. No one has seen his face.",
        "first_seen": "_22jk9q9fj",
        "created_at": "2026-05-29T17:11:26.736552+00:00",
        "updated_at": "2026-05-29T17:11:27.085955+00:00"
      },
      {
        "id": "_rnd4s4rvj",
        "slug": "magistrix-orvenne-lhast",
        "name": "Magistrix Orvenne Lhast",
        "role": "Head of the Merchant's Compact, Ashenveil",
        "disposition": "hostile",
        "notes": "Cold, methodical, never raises her voice. Runs the Compact like a ledger — everything has a price. Has hired at least two separate groups to follow the party. The party has never met her face-to-face; they know her only by reputation and the calling cards she leaves at crime scenes.",
        "first_seen": "_ani8i45r7",
        "created_at": "2026-05-29T17:11:26.736552+00:00",
        "updated_at": "2026-05-29T17:11:27.085955+00:00"
      },
      {
        "id": "_mh14q5mwp",
        "slug": "lord-aldric-thane",
        "name": "Lord Aldric Thane",
        "role": "Disgraced noble, exile at the Sunken Hearth inn",
        "disposition": "neutral",
        "notes": "Former city councillor removed under suspicious circumstances three years ago. Drinks heavily and claims the Compact framed him. Some of what he says checks out. Knows the layout of the Compact's headquarters from his time on the council.",
        "first_seen": "_ani8i45r7",
        "created_at": "2026-05-29T17:11:26.736552+00:00",
        "updated_at": "2026-05-29T17:11:27.085955+00:00"
      },
      {
        "id": "_873zlebcd",
        "slug": "wren-ashford",
        "name": "Wren Ashford",
        "role": "Archivist, Hall of Records",
        "disposition": "friendly",
        "notes": "Meticulous, anxious, brilliant. Has access to land deeds, tax records, and guild charters going back 200 years. Helped the party trace Compact property holdings in Session 4. Terrified of the Compact finding out she helped. Keeps detailed notes in a cipher the party can't read.",
        "first_seen": "_ani8i45r7",
        "created_at": "2026-05-29T17:11:26.736552+00:00",
        "updated_at": "2026-05-29T17:11:27.085955+00:00"
      }
    ],
