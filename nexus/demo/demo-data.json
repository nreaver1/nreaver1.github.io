    "session_log": [
      {
        "id": "_22jk9q9fj",
        "number": 2,
        "title": "The Body at the Crossroads",
        "real_date": "2026-05-08",
        "world_date": "7th of Ashfall, Year 412",
        "summary": "A corpse was found at the crossroads outside the East Gate — a Compact courier, throat cut, signet ring missing. ^commander-varek-stoneholm arrived before the party could examine the body properly and confiscated what little evidence remained. ^sister-maela tended to the body and slipped the party a detail the Watch missed: a second set of boot prints, child-sized, leading toward the market. Following the trail, the party located ^pip, who had witnessed the murder from a drainpipe. Pip described the killer as \"a man with no face\" — the first confirmed sighting of ^the-hollow-man. The missing signet ring matches one Varek wears.",
        "status": "complete",
        "quests": [
          {
            "_key": "_cujigxkvt",
            "text": "Identify the brass cylinder recovered from the warehouse",
            "status": "active"
          },
          {
            "_key": "_vw3bjdguo",
            "text": "Discover who killed the Compact courier and why",
            "status": "active"
          },
          {
            "_key": "_1anmw74eu",
            "text": "Learn more about the Hollow Man",
            "status": "active"
          }
        ],
        "session_npcs": [
