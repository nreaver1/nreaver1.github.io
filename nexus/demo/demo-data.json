      },
      {
        "id": "_p1m1da53t",
        "session_id": "_wob4htma3",
        "text": "The Hollow Man was seen watching from the alley opposite. Did not intervene in either direction.",
        "members": [],
        "sort_order": 2,
        "created_at": "2026-05-29T17:11:27.000812+00:00"
      },
      {
        "id": "_gsyxi8pwy",
        "session_id": "_ani8i45r7",
        "text": "Wren found the shell company chain in under an hour — \"this is not subtle, whoever filed this was arrogant\"",
