# ─────────────────────────────────────────
# Keep Track — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub
# ─────────────────────────────────────────

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Set to true to run on built-in demo data (src/demo) with no Supabase project.
# Regenerate the data after editing the SQL seed: node scripts/build-demo-seed.mjs
# VITE_DEMO_MODE=true
