{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npx -y pnpm@12.8.1 install --frozen-lockfile",
  "buildCommand": "node scripts/vercel-build.mjs",
  "ignoreCommand": "sh scripts/vercel-ignore.sh",
  "crons": [
    {
      "path": "/api/internal/dispatch",
      "schedule": "0 13 * * *"
    }
  ]
}
