# Copy to .env and adjust. Never commit real secrets.

# --- Option A: no Docker. Run `pnpm db:local` in another terminal (PGlite on port 5433). ---
DATABASE_URL=postgres://postgres@127.0.0.1:5433/postgres
DATABASE_POOL_MAX=1

# --- Option B: Docker (`pnpm db:up`), then `pnpm db:migrate && pnpm db:seed`. ---
# App connection: non-superuser role so Row-Level Security applies.
# DATABASE_URL=postgres://ironed_app:ironed_app_dev@localhost:5432/ironed_out
# Migrations/seed run as the schema owner.
# MIGRATION_DATABASE_URL=postgres://ironed_owner:ironed_owner_dev@localhost:5432/ironed_out

APP_URL=http://localhost:3000

# Server secret: signs device cookies, derives invite tokens. Required in production:
# `openssl rand -base64 48`. Rotating it breaks existing invite links.
# APP_SECRET=

# Optional: real email (otherwise emails land in /dev/outbox in dev).
# RESEND_API_KEY=
# EMAIL_FROM=Ironed Out <noreply@yourdomain.com>

# Optional: real SMS. Without these the app runs in SMS demo mode (codes shown on screen).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# TWILIO_MESSAGING_SERVICE_SID=
